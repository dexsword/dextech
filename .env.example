# Server
PORT=3000

# Admin panel — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=your-secret-admin-token-here

# Email confirmations — sends ICS calendar invite to customer (all three required to enable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
# Optional: override the From address
# EMAIL_FROM="Dex Tech" <bookings@dextech.cloud>

# Google Calendar — creates/deletes events in your calendar on booking/cancellation
# Run: node gcal-auth.js to generate GOOGLE_REFRESH_TOKEN
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional: defaults to primary calendar
# GOOGLE_CALENDAR_ID=primary

# Site URL — used to build the cancel link in Google Calendar event descriptions
SITE_URL=https://dextech.cloud

# Optional: restrict CORS to specific origins (comma-separated)
ALLOWED_ORIGINS=https://dextech.cloud,https://www.dextech.cloud
